# Dedicated disposable LOCAL or test project only. Never use production.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=YOUR_LOCAL_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_LOCAL_SERVICE_ROLE_KEY
DEVCARE_TEST_ALLOW_RESET=YES_DISPOSABLE_PROJECT
# Local inbox supports example.test. For hosted tests, use a domain/catch-all you control.
DEVCARE_TEST_EMAIL_DOMAIN=example.test
