{
  "name": "devcare",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:database": "node scripts/test-database.mjs",
    "test:integration": "node --env-file=.env.test scripts/integration.mjs",
    "test:browser": "playwright test",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "bootstrap:admin": "node --env-file=.env.admin scripts/bootstrap-admin.mjs",
    "seed:dev": "node --env-file=.env.test scripts/seed-dev.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.99.0",
    "@tanstack/react-query": "^5.90.21",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-router-dom": "^7.13.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.2.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.0",
    "vitest": "^5.0.3"
  }
}
